data/
logs/

# ---- 构建产物与内部报告 ----
_build/

# ---- WorkBuddy 项目数据（内部记忆，不发布）----
.workbuddy/

# ---- IDE / 操作系统 ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- 测试 / 覆盖率 ----
