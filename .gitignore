# ---- Python 编译产物 ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 环境变量 / 敏感信息 ----
.env
.env.*
!.env.example

